(version 1)

# =============================================================================
# Atari ST ROM Cartridge v2 — Custom Design Rules
# 2-vrstvová THT doska, 1 oz Cu, výroba JLCPCB standard
# =============================================================================

# -----------------------------------------------------------------------------
# Základné limity (všetky siete)
#   JLCPCB minimum: 0.1 mm trace/space, 0.3 mm via drill, 0.15 mm annular ring
#   Tu: 2× rezerva nad minimum pre spoľahlivú výrobu
# -----------------------------------------------------------------------------
(rule "Default"
  (constraint clearance           (min 0.2mm))
  (constraint track_width         (min 0.2mm)   (opt 0.25mm))
  (constraint via_diameter        (min 0.6mm))
  (constraint annular_width       (min 0.15mm))
  (constraint hole_size           (min 0.3mm))
  (constraint hole_to_hole        (min 0.5mm))
  (constraint hole_clearance      (min 0.3mm))
  (constraint edge_clearance      (min 0.5mm))
  (constraint silk_clearance      (min 0.1mm))
  (constraint courtyard_clearance (min 0.5mm))
)

# -----------------------------------------------------------------------------
# Výnimka pre J1 (Atari ST Cartridge Edge Connector)
#   Piny J1 musia ležať pri okraji dosky — edge_clearance = 0
# -----------------------------------------------------------------------------
(rule "Edge_Connector_J1"
  (condition "A.insideCourtyard('J1')")
  (constraint edge_clearance (min 0.0mm))
)

# -----------------------------------------------------------------------------
# Napájacie vetvy (+5V a GND)
#   Prúdová záťaž: 2× W29C040-90B ICC1_max = 2 × 60 mA = 120 mA
#   IPC-2221A, 1 oz Cu, ΔT = 10 °C: 0.6 mm → ~300 mA (2.5× rezerva)
#
#   POŽIADAVKA: v Board Setup → Design Rules → Net Classes
#     → pridaj triedu "Power" a priraď siete +5V a GND
# -----------------------------------------------------------------------------
(rule "Power_Rail"
  (condition "A.NetClass == 'Power'")
  (constraint track_width   (min 0.6mm)  (opt 0.6mm))
  (constraint clearance     (min 0.3mm))
  (constraint via_diameter  (min 0.8mm))
)
